# Copy to .env and fill in keys
# GOOGLE / YOUTUBE tokens are stored separately as token.pickle, token_youtube.pickle
GOOGLE_API_KEY=
YOUTUBE_API_KEY=
CAP_VOCAB_LLM_PROVIDER=auto
CAP_VOCAB_GEMINI_MODEL=gemini-2.5-flash
CAP_VOCAB_OPENAI_MODEL=gpt-4o-mini
CAP_CLOZE_LLM_PROVIDER=auto
CAP_CLOZE_MODEL=gemini-2.5-flash
CAP_CLOZE_REVIEW_MODEL=gemini-2.5-flash
CAP_CLOZE_OPENAI_MODEL=gpt-4o-mini
CAP_CLOZE_OPENAI_REVIEW_MODEL=gpt-4o-mini
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
CAP_NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
CAP_SUBTITLE_REVIEW_NVIDIA_FALLBACK_MODEL=nvidia/nemotron-3-nano-30b-a3b
CAP_STORYBOARD_NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
ARK_API_KEY=
ARK_VIDEO_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_POLL_SECONDS=10
